{
  "name": "sandpipe",
  "version": "0.1.3",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "description": "在 @ai-hero/sandcastle 之上的 issue → PR → 合并流水线：prep 拆票、确定性排期、implement + review、测试门槛、自动合并。项目差异在目标项目的 .sandcastle/sandcastle.config.ts。",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "sandpipe": "./dist/cli.js"
  },
  "files": [
    "dist",
    "prompts",
    "templates",
    "claude",
    "docs/onboarding-checklist.md",
    "docs/onboarding-checklist.zh-CN.md",
    "docs/config.md",
    "docs/config.zh-CN.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "sandcastle": {
    "releases": "kobe4cn/sandcastle-releases"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:comments": "node scripts/check-comments.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "esbuild": "^0.28.2"
  }
}
