FROM node:22-bookworm

# 装系统依赖
# Install system dependencies
RUN apt-get update && apt-get install -y \
  git \
  curl \
  jq \
  fonts-noto-cjk \
  && rm -rf /var/lib/apt/lists/*

# 装 GitHub CLI
# Install GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
  | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
  | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
  && apt-get update && apt-get install -y gh \
  && rm -rf /var/lib/apt/lists/*

# 浏览器验收：playwright-cli 与无头 Chromium。
# linux/arm64 没有 Google Chrome，所以用 Playwright 自带的 Chromium；浏览器装在共享目录，agent 用户也能用。
# Browser check: playwright-cli with headless Chromium.
# linux/arm64 has no Google Chrome, so use Playwright's bundled Chromium; browsers live in a shared directory so the agent user can use them too.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PLAYWRIGHT_MCP_BROWSER=chromium
RUN npm install -g @playwright/cli@0.1.23 \
  && node "$(npm root -g)/@playwright/cli/node_modules/playwright/cli.js" install --with-deps chromium \
  && chmod -R a+rX /ms-playwright \
  && rm -rf /var/lib/apt/lists/*

# 对齐 UID/GID 的构建参数：sandcastle 建镜像时默认取宿主机用户的 UID/GID，
# 镜像里建的文件和挂载进来的文件属于同一个用户，运行时不用 chown。
# Build-args for UID/GID alignment: sandcastle docker build-image
# defaults these to the host user's UID/GID so image-built files
# and bind-mounted files share an owner without runtime chown.
ARG AGENT_UID=1000
ARG AGENT_GID=1000

# 把基础镜像的 node 用户改名为 agent，并对齐 UID/GID。
# Rename the base image's "node" user to "agent" and align UID/GID.
RUN groupmod -o -g $AGENT_GID node && usermod -o -u $AGENT_UID -g $AGENT_GID -d /home/agent -m -l agent node
USER ${AGENT_UID}:${AGENT_GID}

# 装 Claude Code CLI
# Install Claude Code CLI
RUN curl -fsSL https://claude.ai/install.sh | bash

# 把 Claude 加进 PATH
# Add Claude to PATH
ENV PATH="/home/agent/.local/bin:$PATH"

WORKDIR /home/agent

# worktree 沙箱模式下，Sandcastle 把 git worktree 挂到 /home/agent/workspace，
# 容器启动时工作目录也改成 /home/agent/workspace。
# 镜像要让 /home/agent/workspace 能当项目根目录用。
# In worktree sandbox mode, Sandcastle bind-mounts the git worktree at /home/agent/workspace
# and overrides the working directory to /home/agent/workspace at container start.
# Structure your Dockerfile so that /home/agent/workspace can serve as the project root.
ENTRYPOINT ["sleep", "infinity"]
